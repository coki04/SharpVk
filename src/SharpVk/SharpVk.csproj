<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>FacticiusVir</Authors>
    <Company />
    <Version>0.0.0</Version>
    <Description>C# Bindings for the Vulkan API</Description>
    <PackageLicense>https://github.com/FacticiusVir/SharpVk/blob/master/LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/FacticiusVir/SharpVk</PackageProjectUrl>
    <PackageTags>Vulkan SPIR-V Spirv SharpVK 3D</PackageTags>
    <Copyright>Copyright 2020 Andrew Armstrong/FacticiusVir</Copyright>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <PackageReleaseNotes />
    <Icon>https://raw.githubusercontent.com/FacticiusVir/SharpVk/master/images/SharpVk.png</Icon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <DocumentationFile>bin\Debug\SharpVk.xml</DocumentationFile>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <DocumentationFile>bin\Release\SharpVk.xml</DocumentationFile>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8500</NoWarn>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

</Project>
