<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.0.0</Version>
    <Authors>FacticiusVir</Authors>
    <Company>FacticiusVir</Company>
    <Description>GlmSharp type mappings for SharpVk Shanq</Description>
    <PackageTags>Vulkan SPIR-V Spirv SharpVK Shanq 3D</PackageTags>
    <Copyright>Copyright 2020 Andrew Armstrong/FacticiusVir</Copyright>
    <PackageLicense>https://github.com/FacticiusVir/SharpVk/blob/master/LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/FacticiusVir/SharpVk</PackageProjectUrl>
    <Icon>https://raw.githubusercontent.com/FacticiusVir/SharpVk/master/images/SharpVk.png</Icon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GlmSharp-netstandard" Version="0.9.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpVk\SharpVk.csproj" />
    <ProjectReference Include="..\SharpVk.Shanq\SharpVk.Shanq.csproj" />
  </ItemGroup>

</Project>
