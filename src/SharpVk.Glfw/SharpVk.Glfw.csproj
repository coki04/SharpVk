<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.0.0</Version>
    <Authors>FacticiusVir</Authors>
    <Company />
    <Product />
    <Description>GLFW3 Bindings for C# with Vulkan support via SharpVk</Description>
    <Copyright>Copyright 2020 Andrew Armstrong/FacticiusVir</Copyright>
    <PackageTags>Vulkan SharpVk Glfw 3D</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicense>https://github.com/FacticiusVir/SharpVk/blob/master/LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/FacticiusVir/SharpVk</PackageProjectUrl>
    <Icon>https://raw.githubusercontent.com/FacticiusVir/SharpVk/master/images/SharpVk.png</Icon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\ReleaseSharpVk.Glfw.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <DocumentationFile>bin\DebugSharpVk.Glfw.xml</DocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <OutputPath>bin\Debug</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpVk\SharpVk.csproj" />
  </ItemGroup>

</Project>
